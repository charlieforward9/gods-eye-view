  PERIOD["Event period<br/>query and layer filters"]
  COVERAGE["Shared source coverage<br/>bounds, loading, live only"]
  CLOCK["Shared world clock<br/>cursor + playback"]
  COCKPIT["Shared Cockpit facade<br/>subject identity + entry gates"]
  PROVIDER["Shared provider commands<br/>text agent + cancellation"]
  OAUTH["Shared Realtime adapter<br/>explicit ChatGPT OAuth"]
  ACTIONS["Shared action runner<br/>map tools + entity queries"]
  GLOBE["One shared globe + layers<br/>trails, routes, orbit, ships"]
  HTTP["Shared HTTP text chat<br/>OpenAI / Gemini"]
  PROFILE["Server-owned map-chat profile<br/>canonical tools + instructions"]

  UI <-->|intents / snapshots| KERNEL
  COVERAGE -->|bounds + context| KERNEL
